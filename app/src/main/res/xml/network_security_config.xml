<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- FOR DEVELOPMENT ONLY - bypasses certificate validation for stretto.tplinkdns.com -->
    <domain-config>
        <domain includeSubdomains="true">stretto.tplinkdns.com</domain>
        <trust-anchors>
            <certificates src="@raw/isrgrootx1"/>
            <certificates src="@raw/isrgrootx2"/>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
        <!-- Disable hostname verification for this domain -->
        <pin-set expiration="2025-12-31">
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
        </pin-set>
    </domain-config>

    <base-config>
        <trust-anchors>
            <certificates src="@raw/isrgrootx1"/>
            <certificates src="@raw/isrgrootx2"/>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <!-- Debug override for development builds -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="@raw/isrgrootx1"/>
            <certificates src="@raw/isrgrootx2"/>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
